# Copie este arquivo para ".env" e preencha as chaves.

PORTA=8000
SENHA_PROFESSOR=psicologia
SEGREDO=troque-por-um-texto-aleatorio

# ---------- Cérebro (LLM) — qualquer API compatível com OpenAI ----------
# Groq (gratuito, rápido): crie a chave em https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODELO=llama-3.3-70b-versatile
# Alternativas:
#  Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODELO=gemini-2.5-flash
#  OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODELO=gpt-4o-mini
#  Ollama (local, sem internet):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODELO=qwen2.5:7b
LLM_TEMPERATURA=0.8

# ---------- Ouvido (reconhecimento de fala / Whisper) ----------
# Se ficar em branco, usa o mesmo endereço e chave do LLM (funciona com Groq e OpenAI).
STT_BASE_URL=
STT_API_KEY=
STT_MODELO=whisper-large-v3-turbo
# Na OpenAI use STT_MODELO=whisper-1

# ---------- Voz (TTS) ----------
# edge = vozes neurais pt-BR gratuitas (precisa de internet)
TTS_PROVEDOR=edge
TTS_VOZ_PADRAO=pt-BR-FranciscaNeural
# Para usar a OpenAI: TTS_PROVEDOR=openai e preencha TTS_OPENAI_API_KEY
TTS_OPENAI_API_KEY=

# ---------- Robô ----------
# Tempo de silêncio (ms) para considerar que o aluno terminou de falar
SILENCIO_FIM_FALA_MS=900
# Conversas sem aluno identificado são encerradas após N minutos parados
SESSAO_AVULSA_EXPIRA_MIN=20
# Senha opcional para os robôs (deixe vazio no laboratório)
TOKEN_DISPOSITIVO=

# Mostrar nota e devolutiva ao aluno logo após o laudo (1 = sim, 0 = só o professor vê)
MOSTRAR_RESULTADO_ALUNO=1
